{
  "ConnectionStrings": {
    "ProxyDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=SecureProxy;Trusted_Connection=True"
  },
  "Proxy": {
    "RateLimitPermits": 100,
    "RateLimitWindowSeconds": 10,
    "AdminRateLimitPermits": 30,
    "AdminRateLimitWindowSeconds": 60,
    "MaxConcurrentRequestsPerDestination": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
